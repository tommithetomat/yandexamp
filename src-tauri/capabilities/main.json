{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Only the local player window may talk to the backend. The Yandex login window (label \"auth\") loads a remote site and gets no permissions at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-restore-session",
    "allow-login-password",
    "allow-login-token",
    "allow-login-browser",
    "allow-logout",
    "allow-search",
    "allow-track-stream-url",
    "allow-prefetch-track",
    "allow-refresh-tracks",
    "allow-get-playlists",
    "allow-get-smart-playlists",
    "allow-get-liked-tracks",
    "allow-get-liked-ids",
    "allow-like-track",
    "allow-unlike-track",
    "allow-dislike-track",
    "allow-set-wave-settings",
    "allow-get-wave-tracks",
    "allow-wave-feedback",
    "allow-get-playlist-tracks",
    "allow-get-lyrics",
    "allow-get-stations-list",
    "allow-get-station-tracks",
    "allow-get-track-radio",
    "allow-get-chart",
    "allow-get-new-releases",
    "allow-get-play-history",
    "allow-get-artist",
    "allow-get-album-tracks",
    "allow-check-update",
    "allow-open-releases",
    "allow-win-set-height",
    "allow-win-set-width",
    "allow-win-layout",
    "allow-win-set-pin",
    "allow-win-hide",
    "allow-win-close"
  ]
}
